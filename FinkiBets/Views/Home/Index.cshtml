@{
    ViewData["Title"] = "FINKI KAZZINO - Live Sports";
}
@model List<FinkiBets.Domain.Domain.Match>

@{
    ViewData["Title"] = "FinkiBets - Premium Sportsbook";
}

<style>
    body {
        background-color: #0f1215;
        color: #e9ecef;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    .main-hub {
        padding-top: 50px;
        background: radial-gradient(circle at top right, #1c2229, #0f1215);
        min-height: 90vh;
    }

    .promo-banner {
        background: linear-gradient(45deg, #1a1d20 0%, #2c343c 100%);
        border-left: 5px solid #ffc107;
        padding: 40px;
        border-radius: 10px;
        margin-bottom: 50px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    .sport-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        padding: 30px;
        text-align: center;
        transition: transform 0.3s ease, background 0.3s ease;
        cursor: pointer;
        text-decoration: none;
        display: block;
        color: white;
    }

        .sport-card:hover {
            transform: translateY(-10px);
            background: rgba(255, 255, 255, 0.1);
            color: #ffc107;
            border-color: #ffc107;
        }

    .sport-icon {
        font-size: 4rem;
        margin-bottom: 20px;
        display: block;
    }

    .btn-ticket {
        background-color: #ffc107;
        color: #000;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 2px;
        padding: 15px 40px;
        border-radius: 50px;
        box-shadow: 0 4px 15px rgba(255, 193, 7, 0.3);
    }

        .btn-ticket:hover {
            background-color: #e5ac00;
            transform: scale(1.05);
        }
</style>

<div class="main-hub">
    <div class="container text-center">
        <div class="promo-banner">
            <h1 class="display-3 fw-bold mb-3">FINKI<span class="text-warning">BETS</span></h1>
            <p class="lead mb-4">Your ultimate destination for professional sports wagering.</p>
            <a asp-action="MyTicket" asp-controller="Ticket" class="btn btn-ticket btn-lg">
                <i class="bi bi- receipt-cutoff me-2"></i> View My Tickets
            </a>
        </div>

        <h2 class="mb-5">Select Your Arena</h2>

        <div class="row g-4 justify-content-center">
            <div class="col-md-5">
                <a asp-action="Football" asp-controller="Matches" class="sport-card">
                    <span class="sport-icon"><i class="bi bi-patch-check-fill text-primary"></i></span>
                    <h3 class="fw-bold">FOOTBALL</h3>
                    <p class="text-muted">International Leagues, Champions League & World Cups</p>
                    <span class="btn btn-outline-warning mt-3">Enter Stadium</span>
                </a>
            </div>

            <div class="col-md-5">
                <a asp-action="Basketball" asp-controller="Matches" class="sport-card">
                    <span class="sport-icon"><i class="bi bi-dribbble text-orange" style="color: #fd7e14;"></i></span>
                    <h3 class="fw-bold">BASKETBALL</h3>
                    <p class="text-muted">NBA Player Props, EuroLeague & Points Over/Under</p>
                    <span class="btn btn-outline-warning mt-3">Enter Court</span>
                </a>
            </div>
        </div>

        <div class="mt-5 pt-5">
            <p class="text-muted small">
                <i class="bi bi-shield-lock me-1"></i> Secure Admin Dashboard | Licensed & Regulated
            </p>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">