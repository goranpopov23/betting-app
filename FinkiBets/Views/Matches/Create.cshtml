@model FinkiBets.Domain.Domain.Match

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>Match</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="matchType" class="control-label"></label>
                <select id="sportSelector" asp-for="matchType" asp-items="@ViewBag.matchType" class="form-control">
                    <option value="">-- Select Sport --</option>
                </select>
                <span asp-validation-for="matchType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="startTime" class="control-label"></label>
                <input asp-for="startTime" class="form-control" />
                <span asp-validation-for="startTime" class="text-danger"></span>
            </div>
            <div id="footballFields" style="display:none;">
                <div class="form-group">
                    <label class="control-label">Home Team</label>
                    <input name="homeTeam" id="homeTeam" class="form-control" placeholder="e.g. Real Madrid" />
                </div>
                <div class="form-group">
                    <label class="control-label">Away Team</label>
                    <input name="awayTeam" id="awayTeam" class="form-control" placeholder="e.g. Barcelona" />
                </div>
            </div>

            <div id="basketballFields" style="display:none;">
                <div class="form-group">
                    <label class="control-label">Player Name</label>
                    <input name="playerName" id="playerName" class="form-control" placeholder="e.g. LeBron James" />
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            $("#sportSelector").change(function () {
                var selectedType = $(this).val();

                // Logic depends on the integer values of your Enum (0 = Football, 1 = Basketball)
                if (selectedType == "Football") {
                    $("#footballFields").show();
                    $("#basketballFields").hide();
                } else if (selectedType == "Basketball") {
                    $("#footballFields").hide();
                    $("#basketballFields").show();
                } else {
                    $("#footballFields").hide();
                    $("#basketballFields").hide();
                }
            });            
        });
    </script>
}
