@model FinkiBets.Domain.DTO.TicketDTO

<div class="card bg-dark text-white border-secondary">
    <div class="card-body p-0">
        <table class="table table-dark table-hover mb-0">
            <thead>
                <tr class="table-secondary text-dark">
                    <th>Time</th>
                    <th>Match</th>
                    <th>Bet</th>
                    <th class="text-end">Odds</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ticketBets)
                {
                    <tr>
                        <td>
                            <div class="fw-bold">@item.OddSelection.Match.startTime.ToString("MMM dd")</div>
                            <small class="text-muted">@item.OddSelection.Match.startTime.ToString("h:mm tt")</small>
                        </td>
                        <td>@item.OddSelection.Match.Name</td>
                        <td><span class="badge bg-primary">@item.OddSelection.Label</span></td>
                        <td class="text-end fw-bold">@item.OddSelection.Odds.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer border-secondary p-3">
        <div class="d-flex justify-content-between mb-2">
            <span>Total Odds:</span>
            <span class="fw-bold text-success" id="totalOdds">@Model.totalOdds.ToString("N2")</span>
        </div>

        <div class="form-group mb-3">
            <label class="small text-muted">Stake Amount ($)</label>
            <input type="number" id="betAmount" class="form-control bg-dark text-white border-secondary" placeholder="0.00">
            <small id="balanceError" class="text-danger d-none" style="text-decoration: underline;">
                Insufficient balance!
            </small>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted">Potential Win:</span>
            <h4 class="text-info mb-0">$<span id="potWin">0.00</span></h4>
        </div>

        <button type="button" class="btn btn-warning w-100 fw-bold" id="btnPlaceBet">PLACE BET</button>
    </div>
</div>

<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Confirm Your Bet</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to place this parlay for <span id="modalStakeText" class="text-warning"></span>?
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="finalConfirm" data-ticket-id="@Model.TicketId" class="btn btn-success px-4">Yes, Place Bet</button>
            </div>
        </div>
    </div>
</div>
<div id="successAlert" class="alert alert-success alert-dismissible fade show d-none" role="alert">
    <strong>Success!</strong> You have successfully placed your bet.
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>

<script>
    const userBalance = @Model.accountBalance; 
    const totalOdds = parseFloat("@Model.totalOdds");
    const betInput = document.getElementById('betAmount');
    const potWinDisplay = document.getElementById('potWin');
    const balanceError = document.getElementById('balanceError');
    const btnPlaceBet = document.getElementById('btnPlaceBet');

    // Update Potential Win and Check Balance
    betInput.addEventListener('input', function() {
        const stake = parseFloat(this.value) || 0;

        // 1. Calculate potential win
        potWinDisplay.innerText = (stake * totalOdds).toFixed(2);

        // 2. Check balance
        if (stake > userBalance) {
            balanceError.classList.remove('d-none');
            this.classList.add('border-danger');
            btnPlaceBet.disabled = true;
        } else {
            balanceError.classList.add('d-none');
            this.classList.remove('border-danger');
            btnPlaceBet.disabled = false;
        }
    });

    // Show Confirmation Modal
    btnPlaceBet.addEventListener('click', function() {
        if(parseFloat(betInput.value) > 0) {
            document.getElementById('modalStakeText').innerText = "$" + betInput.value;
            var myModal = new bootstrap.Modal(document.getElementById('confirmModal'));
            myModal.show();
        }
    });

        document.getElementById('finalConfirm').addEventListener('click', function() {
        const stakeValue = parseFloat(document.getElementById('betAmount').value);
        const button = this;
        const ticketId = button.dataset.ticketId;

        fetch('/Ticket/PlaceBet', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: `ticketId=${ticketId}&stake=${stakeValue}`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert("You have successfully placed a bet.")

                        // 4. Finally, redirect
                        window.location.href = "/Home/Index";
                  // 2.5 seconds delay
            } else {
                alert("Error: " + data.message);
            }
        })
        .catch(error => console.error('Error:', error));
    });
</script>