@page
@model AddFundsModel
@{
    ViewData["Title"] = "Add Funds";
    ViewData["ActivePage"] = ManageNavPages.AddFunds;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="row">
    <div class="col-md-6">
        <div class="card bg-light mb-3">
            <div class="card-body">
                <p class="card-text">Securely add virtual credits to your betting account.</p>
            </div>
        </div>
        <form id="add-funds-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Amount" class="form-control" type="number" step="0.01" placeholder="0.00" />
                <label asp-for="Input.Amount" class="form-label"></label>
                <span asp-validation-for="Input.Amount" class="text-danger"></span>
            </div>
            <button id="update-balance-button" type="submit" class="w-100 btn btn-lg btn-success">Deposit Funds</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}